<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_profile_selector_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/overscan_horizontal"
    android:paddingTop="@dimen/profile_selector_padding_top"
    android:paddingBottom="@dimen/overscan_vertical">

    <TextView
        android:id="@+id/brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans"
        android:letterSpacing="0.12"
        android:text="@string/profile_selector_brand"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans"
        android:gravity="center"
        android:text="@string/who_is_watching"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="44sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Who's watching?" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/profile_selector_secondary_text"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="Connected to casa.jellyfin.local" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/users"
        android:layout_width="match_parent"
        android:layout_height="@dimen/profile_selector_grid_height"
        android:layout_marginTop="30dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        app:rowHeight="@dimen/profile_selector_grid_height"
        tools:itemCount="4"
        tools:listitem="@layout/view_card_default" />

    <TextView
        android:id="@+id/no_users_warning"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="@string/no_user_warning"
        android:textColor="@color/profile_selector_secondary_text"
        app:layout_constraintBottom_toBottomOf="@id/users"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/users"
        tools:visibility="gone" />

    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/profile_selector_secondary_text"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/users"
        tools:text="Choose a profile to continue" />

    <LinearLayout
        android:id="@+id/actions_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/message">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/sign_out_button"
            style="@style/Button.ProfileSelector"
            android:layout_width="210dp"
            android:layout_height="51dp"
            android:layout_margin="8dp"
            android:text="@string/lbl_sign_out" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancel_button"
            style="@style/Button.ProfileSelector"
            android:layout_width="210dp"
            android:layout_height="51dp"
            android:layout_margin="8dp"
            android:visibility="gone"
            android:text="@string/btn_cancel" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
